# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# OmniGet CLI — headless image for automation, cron jobs and batch archives.
# No WebKit, no display: this is the `omniget-cli` crate that ships with every
# release, built from source.
#
#   docker build -f docker/Dockerfile.cli -t omniget-cli .
#   docker run --rm -v omniget-data:/data -v "$PWD/downloads:/downloads" \
#              omniget-cli info "https://www.youtube.com/watch?v=..."
#   docker run --rm ... omniget-cli download "<url>" -q 1080 -o /downloads
# ─────────────────────────────────────────────────────────────────────────────

# ---------- 1) Build ----------
FROM rust:1.97-bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev cmake clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*
COPY src-tauri /app/src-tauri
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/app/src-tauri/target,sharing=locked \
    cargo build --release --manifest-path src-tauri/Cargo.toml -p omniget-cli \
    && cp src-tauri/target/release/omniget-cli /usr/local/bin/omniget

# ---------- 2) Runtime ----------
FROM debian:bookworm-slim AS runtime
ENV DEBIAN_FRONTEND=noninteractive \
    OMNIGET_DATA_DIR=/data \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 python3-pip ffmpeg aria2 \
        tini libssl3 libgcc-s1 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
        -o /usr/local/bin/yt-dlp \
    && chmod 0755 /usr/local/bin/yt-dlp
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh
RUN pip3 install --break-system-packages --no-cache-dir gallery-dl \
    && mkdir -p /data /downloads

COPY --from=builder /usr/local/bin/omniget /usr/local/bin/omniget

VOLUME ["/data", "/downloads"]
WORKDIR /downloads

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/omniget"]
CMD ["--help"]