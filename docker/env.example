# Copy this file to `.env` next to docker-compose.yml and change the password.
# Only the values below matter to the OmniGet container; everything else the
# app exposes is configured from its own Settings screen (stored in /data).

VNC_PASSWORD=change-this-to-a-long-random-string
RESOLUTION=1440x900x24
TZ=Africa/Cairo

# Host ports
OMNIGET_PORT=6080
FILES_PORT=8080

# Override to pin an image tag instead of :latest
# OMNIGET_IMAGE=ghcr.io/anub7com/omniget:sha-abc1234