# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# OmniGet — desktop image that can be used from a browser.
#
# OmniGet is a Tauri 2 desktop application, not a web server: the Svelte
# frontend talks to Rust over Tauri IPC. To run it on a server we start a
# virtual X display (Xvfb) with the real WebKitGTK webview and expose that
# display through x11vnc + noVNC. Everything the app can do locally keeps
# working; the only missing piece is audio output (noVNC has no sound).
#
#   docker build -f docker/Dockerfile.desktop -t omniget .
#   docker run -p 6080:6080 -v omniget-data:/data \
#              -v omniget-downloads:/home/omniget/Downloads \
#              -e VNC_PASSWORD=change-me omniget
#
# Then open http://localhost:6080/vnc.html?autoconnect=1&resize=scale
# ─────────────────────────────────────────────────────────────────────────────

# ---------- 1) Frontend: SvelteKit static build (adapter-static) ----------
FROM node:22-bookworm-slim AS frontend
WORKDIR /app
RUN npm install -g pnpm@10.29.3
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY . .
# vite.config.js shells out to `git rev-parse`; .git is not in the context and
# the script already falls back to "unknown", so the build stays reproducible.
RUN pnpm build

# ---------- 2) Rust: Tauri binary, no bundling and no code signing ----------
# `cargo build` (instead of `tauri build`) is deliberate: it embeds the built
# frontend, skips the AppImage/DEB bundlers, and avoids the updater signing
# key requirement documented in the README.
FROM rust:1.97-bookworm AS rust
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev cmake \
        clang libclang-dev patchelf \
        libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev \
        libasound2-dev libpipewire-0.3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY . .
COPY --from=frontend /app/build /app/build
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/app/src-tauri/target,sharing=locked \
    cargo build --release --manifest-path src-tauri/Cargo.toml -p omniget \
    && cp src-tauri/target/release/omniget /usr/local/bin/omniget

# ---------- 3) Runtime: WebKitGTK + virtual display + noVNC ----------
FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/omniget \
    OMNIGET_DATA_DIR=/data \
    DISPLAY=:99 \
    RESOLUTION=1440x900x24 \
    LANG=C.UTF-8

# Runtime packages:
#  * WebKitGTK 4.1 webview and its GTK stack
#  * dbus (session bus for the tray icon and desktop notifications)
#  * GStreamer plugins for in-app playback (software decoding, no GPU)
#  * Xvfb + x11vnc + noVNC for the browser gateway
#  * Mesa software rendering, fonts (Arabic/CJK/emoji), tzdata
#  * yt-dlp/ffmpeg/aria2/gallery-dl toolchain and tini/gosu
RUN apt-get update && apt-get install -y --no-install-recommends \
        libwebkit2gtk-4.1-0 libgtk-3-0 libayatana-appindicator3-1 librsvg2-2 \
        libasound2 libssl3 libdbus-1-3 libnotify4 libxkbcommon0 \
        dbus dbus-x11 \
        gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
        xvfb x11vnc x11-utils novnc websockify \
        libgl1 libegl1 libgles2 libgl1-mesa-dri \
        fonts-dejavu-core fonts-liberation fonts-noto-core \
        fonts-noto-color-emoji fontconfig tzdata \
        ca-certificates curl unzip python3 python3-pip ffmpeg aria2 xdg-utils \
        desktop-file-utils tini gosu \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp standalone binary: the app prefers a managed copy in $DATA/bin but
# falls back to PATH, so this keeps the image usable before the first update.
RUN curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
        -o /usr/local/bin/yt-dlp \
    && chmod 0755 /usr/local/bin/yt-dlp

# yt-dlp needs an external JavaScript runtime for the YouTube player.
# Installed straight from the release asset: the shell installer additionally
# requires an interactive-looking PATH setup and a working `unzip`.
RUN curl -fsSL https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip \
        -o /tmp/deno.zip \
    && unzip -q /tmp/deno.zip -d /usr/local/bin \
    && rm -f /tmp/deno.zip \
    && deno --version

# gallery-dl is a hard dependency for the image/board downloaders.
RUN pip3 install --break-system-packages --no-cache-dir gallery-dl

COPY --from=rust /usr/local/bin/omniget /usr/local/bin/omniget
COPY docker/omniget-entrypoint.sh /usr/local/bin/omniget-entrypoint
COPY docker/novnc-index.html /usr/share/novnc/index.html
RUN chmod 0755 /usr/local/bin/omniget /usr/local/bin/omniget-entrypoint

RUN useradd --create-home --uid 1000 --shell /bin/bash omniget \
    && mkdir -p /data /home/omniget/Downloads \
    && chown -R omniget:omniget /data /home/omniget

EXPOSE 6080
# Fallback working directory: if `dirs::download_dir()` cannot resolve
# `~/Downloads`, the app's default output path is `.`, so it must not be `/`.
WORKDIR /home/omniget
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl -fsS http://127.0.0.1:6080/ >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/omniget-entrypoint"]